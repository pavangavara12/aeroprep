# ==========================================================================
# AeroPrep — AI Voice Assistant configuration
# --------------------------------------------------------------------------
# Copy this file to ".env" and fill in your key. The .env file is gitignored
# and is read ONLY on the server side (Vite middleware / standalone server).
# These values are NEVER bundled into the browser, so your key stays private.
# Do NOT prefix these with VITE_ (that would expose them to the client).
# ==========================================================================

# Your Google Gemini API key (required for AI features).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Model names are configurable so you can update them without code
# changes as Google ships new models. The defaults below target the
# current-generation Flash models.
#
# NOTE: Gemini 2.5 models are scheduled to shut down in Oct 2026. If a
# call starts failing with a "model not found"/404 error, run
#   npm run models       (lists the models your key can access)
# and set the names below to a currently-available model.
# ------------------------------------------------------------------

# Reasoning model (interview questions, coaching, evaluation, summaries).
GEMINI_TEXT_MODEL=gemini-flash-latest

# Speech-to-text: any multimodal Flash model that accepts audio input.
GEMINI_STT_MODEL=gemini-flash-latest

# Text-to-speech model (must support the AUDIO response modality).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Prebuilt TTS voice. Options include: Zephyr, Puck, Charon, Kore,
# Fenrir, Leda, Orus, Aoede, Callirrhoe, Autonoe, Enceladus, and more.
GEMINI_TTS_VOICE=Kore

# ------------------------------------------------------------------
# Gemini LIVE API — real-time voice "Communication Coach".
# The browser never receives GEMINI_API_KEY. Instead the server mints
# a short-lived EPHEMERAL TOKEN (via @google/genai) that the browser
# uses to open the Live WebSocket directly to Google. Run `npm install`
# after pulling this feature so @google/genai is available server-side.
# ------------------------------------------------------------------

# Live native-audio model. Fully configurable — if a call fails with a
# "model not found"/404, run `npm run models` and set a current one, or
# update the SDK: `npm install @google/genai@latest`.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Prebuilt voice used for Live audio replies (same voice catalog as TTS).
GEMINI_LIVE_VOICE=Kore

# API version for ephemeral-token Live connections. In the installed @google/genai
# SDK, ephemeral-token support is v1alpha ONLY: live.connect() uses the
# BidiGenerateContentConstrained method, which v1beta does not complete (the
# WebSocket opens but setupComplete never arrives). Both the server token mint and
# the browser's ai.live.connect() must use this value, so keep them identical.
# Leave as v1alpha unless Google moves ephemeral-token support to another surface.
GEMINI_LIVE_API_VERSION=v1alpha
GEMINI_LIVE_WS_BASE=wss://generativelanguage.googleapis.com

# API base URL (rarely needs changing).
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional: port for the standalone server (npm run server). Vite dev/preview
# do NOT use this — they mount the API as middleware on the Vite port.
AEROPREP_API_PORT=8787
